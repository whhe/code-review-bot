# code-review-bot — copy to .env and fill in required values.
#
#   cp .env.example .env
#
# Legend
#   [required]  must be set for a normal review run
#   [optional]  has a default or can be omitted
#
# Minimal local setup: GIT_REPO_URL, GIT_REPO_TOKEN
# Local runs: set ACP_AGENT_TYPE and auth via that agent's usual setup.

# =============================================================================
# Git platform & repository
# =============================================================================

# [optional] Platform adapter: gitlab (default) | github
GIT_PLATFORM_TYPE=gitlab

# [required] HTTPS clone URL. Keep credentials out of the URL; host/path drive API calls.
# GitLab: https://gitlab.com/group/project.git
# GitHub: https://github.com/owner/repo.git
GIT_REPO_URL=https://gitlab.com/group/project.git

# [required] Token with repo read access and permission to post MR/PR comments. Git clone/fetch
# receives it through an ephemeral credential helper, so it is not persisted in workspace URLs.
GIT_REPO_TOKEN=xxxxxxxxxxxxxxxxxxxx

# [optional] Platform API base URL override. Empty = derive from GIT_REPO_URL.
# GitLab (sub-path install):
#   GIT_REPO_URL=https://example.com/git/group/project.git
#   GIT_PLATFORM_URL=https://example.com/git
# GitHub Enterprise Server (non-standard API path):
#   GIT_PLATFORM_URL=https://github.corp.example.com/api/v3
# GIT_PLATFORM_URL=

# [optional] Parent directory for per-review git workspaces (default: system temp).
# CLONE_BASE_DIR=/tmp/reviews

# [optional] Initial shallow clone depth (0 = full history). The bot automatically fetches the
# missing history when the review refs do not share a locally available merge base.
CLONE_DEPTH=0

# =============================================================================
# Review
# =============================================================================

# [optional] Review skill: local directory path or https URL to SKILL.md.
# If the path or URL is not found / not accessible, the bot warns and falls back to
# native knowledge automatically.
#
# Default: local path installed via:
#   npx skills add whhe/ai-workshop --skill code-review --global --yes
#
# URL (agent fetches on demand — network I/O every run):
#   REVIEW_SKILL=https://example.com/skills/code-review/SKILL.md
#
# Empty: always use native knowledge, skip the check entirely.
REVIEW_SKILL=~/.agents/skills/code-review

# [optional] Language for findings and the change-request summary (not code paths).
# english | chinese
OUTPUT_LANGUAGE=english

# [optional] Extra globs to exclude (JSON array). Built-in defaults already skip
# *.lock, *-lock.json, *.min.js, *.min.css, *.map, **/vendor/**, **/generated/**
# REVIEW_EXCLUDE=["dist/**", "*.pb.go"]

# [optional] Restrict review to matching globs only (JSON array). Empty = all files.
# REVIEW_INCLUDE=["src/**", "tests/**"]

# [optional] Approve the MR/PR via platform API when no new findings are published.
# Revokes approval when new findings exist. Requires token with approval permissions.
AUTO_APPROVE_ON_CLEAN_REVIEW=false

# [optional] Treat a review with only low-severity findings as clean (approve it).
# Has no effect when AUTO_APPROVE_ON_CLEAN_REVIEW is false.
AUTO_APPROVE_IGNORE_LOW_SEVERITY=false

# =============================================================================
# Coding agent (ACP)
# =============================================================================

# [optional] Built-in types use presets in code — leave ACP_COMMAND/ACP_ARGS unset.
#
#   claude → npx -y @zed-industries/claude-agent-acp
#   codex  → npx -y @zed-industries/codex-acp
#   opencode → opencode acp
#
# Custom type: set ACP_AGENT_TYPE plus ACP_COMMAND and ACP_ARGS.
#   ACP_AGENT_TYPE=cursor
#   ACP_COMMAND=agent
#   ACP_ARGS=["acp"]
ACP_AGENT_TYPE=claude

# ACP_COMMAND=
# ACP_ARGS=

# [optional] Model override. OpenCode expects the full provider/model ID.
# ACP_MODEL=

# [optional] Max bytes per ACP JSON frame (default: 10485760 = 10 MB).
# ACP_STREAM_LIMIT=10485760

# [optional] Log ACP input prompts, tool calls, and streamed agent messages.
ACP_VERBOSE=true

# =============================================================================
# Logging
# =============================================================================

# [optional] Bot log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# [optional] Root for bot-generated files (relative to project root).
# Subdirs: <LOG_DIR>/sessions/, <LOG_DIR>/debug-reports/ (--debug). Empty disables file logging.
LOG_DIR=logs

# =============================================================================
# Docker only — image setup and runtime
# =============================================================================
#
# Legend: [docker] variables are only used by Docker images.
# Set agent credentials in this section when running an image with --env-file.
# Images provide a matching ACP_AGENT_TYPE default. A value supplied through --env-file must match
# the selected image tag: claude for :claude-code/:latest, or opencode for :opencode.
#
# Bootstrap target is selected by the image's ACP_AGENT_TYPE; existing config files are kept.
# GitHub Actions publishes :claude-code (also :latest) and :opencode.

# Claude Code image only: whhe/code-review-bot:claude-code (also :latest)
# Bootstrap writes ~/.claude/settings.json when missing.

# [docker, required on first start for Claude Code image] Set exactly one credential (not both):
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# [docker, optional on first start for Claude Code image] Anthropic API base URL.
# ANTHROPIC_BASE_URL=

# [docker, optional on first start for Claude Code image] Model (default: claude-opus-4-6).
# ANTHROPIC_MODEL=claude-opus-4-6

# OpenCode image only: whhe/code-review-bot:opencode
# Bootstrap writes ~/.config/opencode/opencode.json when missing.

# [docker, required at runtime for :opencode] OpenAI-compatible API base URL.
# OPENCODE_UPSTREAM_ENDPOINT=https://api.example.com/v1

# [docker, required at runtime for :opencode] Upstream API credential.
# OPENCODE_UPSTREAM_API_KEY=

# [docker, required on first start for :opencode] Upstream model ID.
# OPENCODE_MODEL=qwen3.7-max

# [docker, optional on first start for :opencode] Model context limit (default: 1000000).
# OPENCODE_CONTEXT_LENGTH=1000000

# [docker, optional for :opencode setup and runtime] Model and global output limit; must be positive
# and smaller than context (default: 65536). Override both limits when selecting another model.
# OPENCODE_EXPERIMENTAL_OUTPUT_TOKEN_MAX=65536
